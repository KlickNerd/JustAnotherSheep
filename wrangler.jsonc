{
  // Cloudflare Workers: liefert die statische Website aus ./dist aus.
  // "npm run build" kopiert ./site nach ./dist (kein Bundler).
  // Unbekannte Pfade bekommen site/404.html, das auf die Startseite leitet.
  "name": "justanothersheep",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
